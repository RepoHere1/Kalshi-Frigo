# Kalshi API Configuration
# Get your API key from: https://trading.kalshi.com/settings/api
KALSHI_API_KEY=your_kalshi_api_key_here

# OpenRouter API Configuration — one key for any model on OpenRouter
# (the bot calls a single model per decision; choose it in your config)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# DRY-mode (simulated book) OpenRouter configuration:
# When LIVE_TRADING_ENABLED=false, the bot uses DRY_OPENROUTER_API_KEY and
# DRY_OPENROUTER_MODEL for AI decisions — these route through the simulated
# book and never bill against a real account balance.
# Get your DRY API key from your master.env or Railway variables.
DRY_OPENROUTER_API_KEY=your_dry_openrouter_api_key_here

# DRY-mode OpenRouter model — must be a `:free` listing to bill $0.
# Example: openrouter/free, nvidia/nemotron-3-super-120b-a12b:free
DRY_OPENROUTER_MODEL=deepseek/deepseek-r1

# Trading Configuration
# Set to 'true' for live trading, 'false' for paper trading
LIVE_TRADING_ENABLED=false

# Logging Configuration
LOG_LEVEL=INFO
ENABLE_FILE_LOGGING=true
ENABLE_CONSOLE_LOGGING=true

# Database Configuration
DATABASE_URL=sqlite:///trading_system.db

# Performance Monitoring
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_LOG_INTERVAL_MINUTES=15
